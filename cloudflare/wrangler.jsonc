{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "oreum-daily-reminders",
  "main": "worker.ts",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "triggers": {
    "crons": [
      "0 0 * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "SUPABASE_URL": "https://cvmmxhnoyhnybiniiedc.supabase.co",
    "RESEND_FROM": "OREUM <alerts@notify.oreumnet.com>",
    "APP_URL": "https://oreum-todo.unboundedvalue.workers.dev"
  }
}
